# Binary object store — content lives outside git history.
# Manifests, seeds, and code are committed; fetched bytes are not.
archive/

# Derived text/metadata from Content Pass 1 — reproducible from archived
# bytes (see content-pass-1/CONTENT-PASS-1-REPORT.md), published as
# release assets, not committed to git history.
derived/

# Historical monolith — GitHub's 100 MB cap. After the split commit,
# do not recreate a root manifest.jsonl; the ledger lives in manifest/.
/manifest.jsonl

# Per-run manifests produced in CI before being appended to the
# sharded committed ledger under manifest/part-*.jsonl.
run-manifest.jsonl
run-manifest-*.jsonl

# Chunk seed files generated by chunk_seeds.py for the bulk crawl.
chunks/

# Transient pending-work selection; regenerated from queue.py each run.
pending-seeds.txt

__pycache__/
*.pyc
