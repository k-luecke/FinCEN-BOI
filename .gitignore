# Binary object store — content lives outside git history.
# Manifests, seeds, and code are committed; fetched bytes are not.
archive/

# Per-run manifests produced in CI before being appended to manifest.jsonl.
run-manifest.jsonl
run-manifest-*.jsonl

# Chunk seed files generated by chunk_seeds.py for the bulk crawl.
chunks/

__pycache__/
*.pyc
